# ============================================================================
#  University Honeypot — configuration template
#
#  Copy this to .env and fill in your own values:
#      cp .env.example .env
#
#  .env is gitignored; THIS file is committed, so it must never hold a real
#  secret. Anything set in the actual process environment overrides .env, which
#  is how a container or Render deployment supplies these instead.
#
#  For container secrets, point at the mounted file rather than pasting a value:
#      TELEGRAM_TOKEN_FILE=/run/secrets/telegram_token
# ============================================================================

# --- Telegram bot -----------------------------------------------------------
# Create a bot with @BotFather, then paste the token it gives you.
TELEGRAM_TOKEN=

# Recipients, comma separated. Both keys are merged. Find an id by having the
# person open the bot, send /start, then run:  python -m app.notify --discover
TELEGRAM_CHAT_ID=
TELEGRAM_CHAT_IDS=

TELEGRAM_SIGNATURE=University Honeypot SOC

# Alert floor for a single event: low | medium | high
TELEGRAM_MIN_SEVERITY=high

# Techniques that always page regardless of the floor (comma separated).
TELEGRAM_ALERT_CATEGORIES=scanner

# Page when a source's aggregate threat score enters a higher band.
TELEGRAM_ESCALATE_FROM=medium
TELEGRAM_ESCALATE_EVERY=20

TELEGRAM_COOLDOWN=600
TELEGRAM_REPORT_EVERY=360
TELEGRAM_QUIET_IDS=1
TELEGRAM_STARTUP=1

# --- Threat intel -----------------------------------------------------------
# Optional. https://www.abuseipdb.com/account/api
ABUSEIPDB_KEY=

# --- Suricata ---------------------------------------------------------------
# Path to eve.json. Setting it enables the live tailer.
SURICATA_EVE=

# Addresses that ARE the honeypot/sensor, so its own outbound traffic is not
# scored as an attack. Comma separated, IPs or CIDRs.
SURICATA_HOME_NET=

SURICATA_MIN_SEV=3

# --- Monitor dashboard ------------------------------------------------------
MONITOR_USER=
MONITOR_PASS=
HONEYPOT_SECRET=

# --- Bait services (SSH + FTP honeypots) ------------------------------------
# Simulated brute-force targets. They log every credential/command and never
# execute anything. Default ports avoid needing admin privileges.
HONEYPOT_SSH_ENABLE=1
HONEYPOT_FTP_ENABLE=1
HONEYPOT_SSH_PORT=2222
HONEYPOT_FTP_PORT=2121
HONEYPOT_SERVICE_BIND=0.0.0.0
HONEYPOT_WEAK_CREDS=root:root,admin:admin,user:user
HONEYPOT_SSH_BANNER=OpenSSH_8.9p1 Ubuntu-3ubuntu0.4
HONEYPOT_FTP_BANNER=vsFTPd 2.3.4
