# ============================================================================
#  University Honeypot — local secrets and machine configuration
#
#  NEVER COMMITTED. This file is listed in .gitignore, so pushing the repo to
#  GitHub or zipping the folder for a server cannot carry it along. On a real
#  deployment prefer the platform's own secret store (Render env vars, Docker
#  secrets); anything set in the real environment overrides this file.
#
#  For container secrets, point at the mounted path instead of pasting a value:
#      TELEGRAM_TOKEN_FILE=/run/secrets/telegram_token
# ============================================================================

# --- Telegram bot -----------------------------------------------------------
TELEGRAM_TOKEN=8948630677:AAHHAonRIV9YASC2bT9Cx3HY_wBH1I7oKiI

# Recipients. Both keys are merged, comma separated. Add a teammate by running
#   python -m app.notify --discover
# after they open the bot and send /start.
#   7132151943  Omar Ziada
#   5367282041  Mahdi Maliha (@mahdimaliha)
#   5118974868  Amir Abu Al-Ezz
TELEGRAM_CHAT_ID=7132151943
TELEGRAM_CHAT_IDS=5367282041,5118974868

TELEGRAM_SIGNATURE=University Honeypot · SOC Alert Engine

# Alert floor for a single event: low | medium | high
TELEGRAM_MIN_SEVERITY=high

# Techniques that always page regardless of the floor. detectors.py rates
# scanner traffic "medium", so without this an entire nmap or nikto sweep would
# arrive silently.
TELEGRAM_ALERT_CATEGORIES=scanner

# Page when a source's aggregate threat score enters a higher band, even when no
# single request was severe. This is what catches a slow sweep.
TELEGRAM_ESCALATE_FROM=medium
TELEGRAM_ESCALATE_EVERY=20

# Seconds before the same (source, technique) can alert again. Everything in
# between is counted and folded into one summary.
TELEGRAM_COOLDOWN=600

# Minutes between periodic reports. 0 disables them.
TELEGRAM_REPORT_EVERY=360

# 1 = never page on informational Suricata alerts (severity 3).
TELEGRAM_QUIET_IDS=1

# 1 = announce on start-up.
TELEGRAM_STARTUP=1

# --- Threat intel -----------------------------------------------------------
ABUSEIPDB_KEY=51782baa172ba8d5d2fc92700fc5054587db494dedfefe23bedb1dda0112f25b7f4e17f9131fb00e

# --- Suricata ---------------------------------------------------------------
# Path to the EVE log; set it and the app follows it live on start-up.
SURICATA_EVE=C:\Users\mahde\Music\university-honeypot\eve.json

# Addresses that ARE the honeypot/sensor. Alerts sourced from here are the box
# talking to the internet (apt, pip, DNS), not an attacker, and are dropped.
SURICATA_HOME_NET=192.168.216.144

# Highest Suricata severity number accepted (1 = most severe, 3 = informational)
SURICATA_MIN_SEV=3

