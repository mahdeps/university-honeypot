# Logs and captured attacker data — never commit

# Decoy database (regenerated on startup)

# TLS certs for the local HTTPS dev server (regenerated on startup) — the
# private key must never be committed
certs/
*.crt
*.key
*.pem

# Suricata capture + ingestion bookmark (large, and holds captured traffic)
*..suricata_offset.json

app/local_config.py

# Python
__pycache__/
*.pyc
.venv/
venv/
env/

# OS / editor
.DS_Store
.idea/
.vscode/

# Scratch / test artifacts (never commit — may hold creds or screenshots)
# (only root-level scratch; portal image assets under app/static must stay)
/_*
